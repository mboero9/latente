{
  "name": "latente",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "build": {
    "command": "npm ci --prefix frontend --no-audit --no-fund && npm --prefix frontend run build"
  },
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  }
}
