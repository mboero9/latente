# Copiar a .env. No commitear .env. Reemplazar marcadores antes de producción.
POSTGRES_USER=latente
POSTGRES_PASSWORD=latente_local_only
POSTGRES_DB=latente

# demo: ficticios. api: reales. auto: demo hasta agregar una clave; luego api.
DATA_MODE=demo
API_FOOTBALL_KEY=
# Opcional: partidos de cricket desde CricketData; clave solo del lado del servidor.
CRICKETDATA_API_KEY=

# free: 30 min en vivo; live: 15 s (requiere cuota suficiente).
SYNC_PROFILE=free
API_DAILY_BUDGET=90
API_MIN_GAP_SECONDS=7
# Railway: usar none para cerrar conexiones inactivas; local: pooled.
DB_POOL_MODE=pooled
# Worker continuo: 0. Cron cada 30 minutos: 1800 (también en el servicio API).
WORKER_EXPECTED_INTERVAL_SECONDS=0
# selected: solo LEAGUE_IDS. all: catálogo global; LEAGUE_IDS mantiene prioridades.
LEAGUE_SCOPE=selected
LEAGUE_IDS=128,129,130,13,11,2,39,140,135,78,61,71

# Opcional: años disponibles en TU plan. Vacío = temporada current del proveedor.
# SEASON_OVERRIDES=128:2024,39:2024
SEASON_OVERRIDES=
# Ajustes opcionales: deben guardar relación con el presupuesto diario.
# LIVE_INTERVAL_SECONDS=15
# STATISTICS_INTERVAL_SECONDS=60
# FIXTURES_INTERVAL_SECONDS=21600
# TABLES_INTERVAL_SECONDS=3600
# SCORERS_INTERVAL_SECONDS=21600

HTTP_BIND=127.0.0.1
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,https://latente.cfd,https://www.latente.cfd,https://latente.dimebag.workers.dev

# Mismo origen en Docker: vacío. Pages: https://api.latente.cfd (sin /api al final).
VITE_API_BASE_URL=

# Cloudflare Tunnel: solo en el VPS. Nunca usar prefijo VITE_ para secretos.
CLOUDFLARE_TUNNEL_TOKEN=

# Publicidad Latente: desactivada por defecto. Son IDs públicos, NO secretos.
# El sitio solo muestra vistas previas en desarrollo, o con preview=true.
# VITE_AD_SLOTS_PREVIEW=true
# VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# VITE_ADSENSE_SLOT_TOP=XXXXXXXXXX
# VITE_ADSENSE_SLOT_SIDE=XXXXXXXXXX
# VITE_ADSENSE_SLOT_BOTTOM=XXXXXXXXXX
# NO activar hasta que AdSense apruebe el sitio, ads.txt sea correcto,
# se configure consentimiento CMP y se adecúe CSP (ver documentación).
VITE_ADSENSE_ENABLED=false
VITE_ADS_PRIVACY_READY=false
